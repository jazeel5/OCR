HOST=127.0.0.1
PORT=8001
# tesseract: local processing; google: sends rasterized pages to Google Cloud Vision.
OCR_PROVIDER=tesseract
TESSERACT_LANG=eng
# Google uses Application Default Credentials (ADC). Never put credentials in frontend files.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_QUOTA_PROJECT=your-project-id
# Optional BCP-47 language hints; leave blank for Google language detection.
GOOGLE_LANGUAGE_HINTS=
# Correct visible page perspective/skew and normalize lighting for local OCR.
PHOTO_PREPROCESSING=true
# Extract ruled tables using detected borders and OCR word positions.
EXTRACT_TABLES=true
MAX_UPLOAD_BYTES=10485760
MAX_PAGES=20
MAX_IMAGE_PIXELS=25000000
MAX_CONCURRENT_DOCUMENTS=2
DOCUMENT_TIMEOUT_SECONDS=150
PAGE_TIMEOUT_SECONDS=35
